<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div>
        <p class="t-h3" style="font-family:var(--font-display)">{{ section.settings.brand_name | default: shop.name }}</p>
        <div class="rule-gold" style="margin:1rem 0"></div>
        <p class="t-lead" style="font-size:0.88rem">{{ section.settings.blurb }}</p>
        <div style="display:flex;gap:0.35rem;margin-top:1.25rem">
          {%- if settings.social_instagram != blank -%}<a class="icon-btn" href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
          {%- if settings.social_facebook != blank -%}<a class="icon-btn" href="{{ settings.social_facebook }}" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<a class="icon-btn" href="{{ settings.social_tiktok }}" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
          {%- if settings.whatsapp_number != blank -%}<a class="icon-btn" href="https://wa.me/{{ settings.whatsapp_number }}" aria-label="WhatsApp">{% render 'icon', name: 'whatsapp' %}</a>{%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading }}</h4>
          <ul>
            {%- for link in linklists[block.settings.menu].links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      <span>{{ section.settings.payment_note }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name" },
    { "type": "textarea", "id": "blurb", "label": "Blurb", "default": "Quiet-luxury Pakistani womenswear. Lawn, chikankari and hand-embroidered formals, dispatched from Lahore." },
    { "type": "text", "id": "payment_note", "label": "Bottom note", "default": "COD · Easypaisa · JazzCash · Card" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop" } },
      { "type": "menu", "settings": { "heading": "Help" } },
      { "type": "menu", "settings": { "heading": "About" } }
    ]
  },
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
