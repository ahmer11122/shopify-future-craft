{%- comment -%} Icon set — clean 1.25px line icons, no clip-art. {%- endcomment -%}
{%- liquid
  assign s = 'stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" fill="none"'
-%}
{%- case name -%}
  {%- when 'search' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" {{ s }}><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
  {%- when 'bag' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" {{ s }}><path d="M6 8h12l1 12H5L6 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
  {%- when 'user' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" {{ s }}><circle cx="12" cy="8.5" r="3.5"/><path d="M5 20c0-3.6 3.1-6 7-6s7 2.4 7 6"/></svg>
  {%- when 'menu' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" {{ s }}><path d="M4 8h16M4 16h16"/></svg>
  {%- when 'close' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" {{ s }}><path d="M6 6l12 12M18 6 6 18"/></svg>
  {%- when 'arrow-up-right' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" {{ s }}><path d="M7 17 17 7M9 7h8v8"/></svg>
  {%- when 'arrow-right' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" {{ s }}><path d="M4 12h16M14 6l6 6-6 6"/></svg>
  {%- when 'chevron-down' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" {{ s }}><path d="m6 9 6 6 6-6"/></svg>
  {%- when 'chevron-left' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" {{ s }}><path d="m15 6-6 6 6 6"/></svg>
  {%- when 'chevron-right' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" {{ s }}><path d="m9 6 6 6-6 6"/></svg>
  {%- when 'heart' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" {{ s }}><path d="M12 20s-7-4.4-7-9.2A3.9 3.9 0 0 1 12 8a3.9 3.9 0 0 1 7 2.8C19 15.6 12 20 12 20Z"/></svg>
  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="m12 3.5 2.6 5.4 5.9.8-4.3 4.1 1 5.9-5.2-2.8-5.2 2.8 1-5.9L3.5 9.7l5.9-.8L12 3.5Z"/></svg>
  {%- when 'truck' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" {{ s }}><path d="M3 16V6h11v10M14 9h4l3 3v4h-7"/><circle cx="7.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
  {%- when 'refresh' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" {{ s }}><path d="M20 12a8 8 0 1 1-2.6-5.9"/><path d="M20 4v4h-4"/></svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" {{ s }}><path d="M12 3.5 19 6v6c0 4-3 7-7 8.5C8 19 5 16 5 12V6l7-2.5Z"/><path d="m9.2 12 2 2 3.6-3.8"/></svg>
  {%- when 'ruler' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" {{ s }}><path d="m3.5 14.5 7-7 6 6-7 7-6-6Z"/><path d="M13 9.5 15 7.5M10.5 12l1.6-1.6M8 14.5l1.6-1.6"/><path d="m16.5 4.5 3 3"/></svg>
  {%- when 'minus' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" {{ s }}><path d="M5 12h14"/></svg>
  {%- when 'plus' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" {{ s }}><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'whatsapp' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1a12 12 0 0 1-4.9-3.4c-1-1.2-1.7-2.5-1.9-3-.2-.4-.5-1.3-.3-2 .2-.7.7-1.1 1-1.3.2-.2.5-.2.7-.2h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .6l-.4.5c-.1.2-.3.3-.1.6.5.9 1 1.5 1.7 2.1.7.5 1.2.8 1.5.9.2.1.4.1.6-.1l.7-.8c.2-.2.3-.2.6-.1l2 .9c.2.1.4.2.4.4.1.2.1.9-.1 1.4Z"/></svg>
  {%- when 'instagram' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" {{ s }}><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="3.8"/><circle cx="17" cy="7" r="0.8" fill="currentColor" stroke="none"/></svg>
  {%- when 'facebook' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" {{ s }}><path d="M14.5 8.5H16V5.8h-2c-2 0-3 1.2-3 3.1v1.6H9v2.7h2V21h2.7v-7.8h2l.4-2.7h-2.4V9.4c0-.6.3-.9.8-.9Z"/></svg>
  {%- when 'tiktok' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" {{ s }}><path d="M14 4v9.6a3.4 3.4 0 1 1-2.8-3.3"/><path d="M14 4c.4 2 1.9 3.4 4 3.6"/></svg>
{%- endcase -%}
